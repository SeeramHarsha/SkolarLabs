# For running locally:  copy to .env  (never commit .env).  On Cloud Run these come from Secret Manager / --set-env-vars.
NODE_ENV=production
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=skolar
# long random strings:  openssl rand -hex 32
JWT_SECRET=
ENROLL_KEY=
# the web address(es) of the FRONTEND (comma separated), e.g. https://skolar-frontend-xxxx-el.a.run.app
FRONTEND_ORIGINS=
# the first admin login (only used when there are no logins yet)
ADMIN_EMAIL=you@yourschool.org
ADMIN_PASSWORD=
