# Copy to .env for local runs. Never commit the real .env.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=botclub_portal
JWT_SECRET=change-me-to-64-random-hex-characters
BASE_URL=https://labs.example.com
# first admin (created on start if missing)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=a-long-password
# payments: razorpay | demo | off
PAYMENT_MODE=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# password-reset emails
SMTP_URL=smtps://user:pass@smtp.example.com:465
MAIL_FROM=Botclub Labs <no-reply@example.com>
SUPPORT_EMAIL=support@example.com
# free chapters for every new student: class/chapter list
TRIAL_CHAPTERS=6/1,7/1,8/1,9/1,10/1
