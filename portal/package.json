{
  "name": "botclub-portal",
  "version": "1.0.0",
  "description": "Botclub Labs learning portal: student sign-up, plans, payments and the interactive NCERT lessons (Express + MongoDB, for Google Cloud Run)",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build-content": "node scripts/build-content.js",
    "make-admin": "node scripts/make-admin.js",
    "demo": "node scripts/demo.js",
    "test": "node --test test/portal.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.12.0",
    "nodemailer": "^10.4.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.4"
  }
}
